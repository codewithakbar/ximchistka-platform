generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  platform_admin
  super_admin
  branch_manager
  operator
  courier
  customer
}

enum OrganizationPlan {
  demo
  active
  expired
  suspended
}

enum OrderStatus {
  draft
  submitted
  received_at_branch
  in_processing
  ready
  out_for_delivery
  completed
  cancelled
}

enum DeliveryType {
  pickup
  delivery
  in_store
}

enum PaymentProvider {
  cash
  click
  payme
  uzum
  transfer
}

enum PaymentStatus {
  pending
  paid
  failed
  refunded
}

model Organization {
  id                String            @id @default(cuid())
  name              String
  slug              String            @unique
  plan              OrganizationPlan  @default(demo)
  demoStartedAt     DateTime?
  demoEndsAt        DateTime?
  isActive          Boolean           @default(true)
  contactPhone      String?
  contactEmail      String?
  /**
   * Chek raqami prefiksi, masalan XC → XC-10009
   */
  orderNumberPrefix String            @default("XC")
  /**
   * Keyingi chek raqami (har yaratilganda +1), 4 xonali: 0001
   */
  orderNumberNext   Int               @default(1)
  /**
   * POS buyurtmada tanlanadigan ranglar ro'yxati
   */
  orderItemColors   String[]          @default([])
  /// Chek (termoprinter) sozlamalari: qog'oz eni, shrift, matnlar
  receiptSettings   Json?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  branches          Branch[]
  users             User[]
  serviceCategories ServiceCategory[]
  promoCodes        PromoCode[]
}

model Branch {
  id                String       @id @default(cuid())
  organizationId    String
  name              String
  address           String
  phone             String
  latitude          Float?
  longitude         Float?
  openTime          String       @default("09:00")
  closeTime         String       @default("20:00")
  isActive          Boolean      @default(true)
  /// Chek prefiksi; null bo'lsa tashkilot prefiksi ishlatiladi
  orderNumberPrefix String?
  /// Shu filialning keyingi chek raqami
  orderNumberNext   Int          @default(1)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  priceRules        PriceRule[]
  orders            Order[]
  userBranches      UserBranch[]

  @@index([organizationId])
}

model User {
  id                 String               @id @default(cuid())
  organizationId     String?
  email              String?              @unique
  phone              String               @unique
  passwordHash       String?
  fullName           String
  avatarUrl          String?
  role               UserRole
  isActive           Boolean              @default(true)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  organization       Organization?        @relation(fields: [organizationId], references: [id])
  customerProfile    CustomerProfile?
  userBranches       UserBranch[]
  statusChanges      OrderStatusHistory[]
  courierDeliveries  PickupDelivery[]     @relation("CourierDeliveries")
  otpCodes           OtpCode[]
  refreshTokens      RefreshToken[]
  telegramAccount    TelegramAccount?
  telegramLoginCodes TelegramLoginCode[]

  @@index([organizationId])
  @@index([organizationId, role])
}

model UserBranch {
  id       String @id @default(cuid())
  userId   String
  branchId String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([userId, branchId])
}

model CustomerProfile {
  id        String            @id @default(cuid())
  userId    String            @unique
  notes     String?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  addresses CustomerAddress[]
  orders    Order[]
}

model CustomerAddress {
  id        String          @id @default(cuid())
  profileId String
  label     String          @default("Uy")
  address   String
  latitude  Float?
  longitude Float?
  isDefault Boolean         @default(false)
  createdAt DateTime        @default(now())
  profile   CustomerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
}

model ServiceCategory {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  description    String?
  sortOrder      Int          @default(0)
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  services       Service[]

  @@index([organizationId])
}

model Service {
  id                 String          @id @default(cuid())
  categoryId         String
  name               String
  description        String?
  unit               String          @default("dona")
  basePrice          Int
  discountType       String?
  discountValue      Int?
  discountValidUntil DateTime?
  /// Konstruktor xizmat: narx va tavsif buyurtma paytida kiritiladi
  isCustom           Boolean         @default(false)
  /// POS va katalogda ko'rsatish tartibi (kichik — oldinroq)
  sortOrder          Int             @default(0)
  isActive           Boolean         @default(true)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  category           ServiceCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  priceRules         PriceRule[]
  orderItems         OrderItem[]

  @@index([categoryId])
}

model PriceRule {
  id        String   @id @default(cuid())
  branchId  String
  serviceId String
  itemType  String   @default("standart")
  price     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  branch    Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  service   Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([branchId, serviceId, itemType])
  @@index([branchId])
  @@index([serviceId])
}

model Order {
  id             String               @id @default(cuid())
  orderNumber    String               @unique
  branchId       String
  customerId     String
  status         OrderStatus          @default(submitted)
  totalAmount    Int                  @default(0)
  notes          String?
  estimatedReady DateTime?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  branch         Branch               @relation(fields: [branchId], references: [id])
  customer       CustomerProfile      @relation(fields: [customerId], references: [id])
  items          OrderItem[]
  statusHistory  OrderStatusHistory[]
  pickupDelivery PickupDelivery?
  payments       Payment[]
  promoCode      String?
  discountAmount Int                  @default(0)

  @@index([branchId, createdAt])
  @@index([branchId, status])
  @@index([customerId])
  @@index([status, updatedAt])
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  serviceId String
  itemType  String   @default("standart")
  quantity  Int      @default(1)
  unitPrice Int
  notes     String?
  color     String?
  photoUrl  String?
  createdAt DateTime @default(now())
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  service   Service  @relation(fields: [serviceId], references: [id])

  @@index([orderId])
  @@index([serviceId])
}

model OrderStatusHistory {
  id        String      @id @default(cuid())
  orderId   String
  status    OrderStatus
  changedBy String?
  note      String?
  createdAt DateTime    @default(now())
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user      User?       @relation(fields: [changedBy], references: [id])

  @@index([orderId, createdAt])
}

model PickupDelivery {
  id          String       @id @default(cuid())
  orderId     String       @unique
  type        DeliveryType
  scheduledAt DateTime?
  address     String?
  courierId   String?
  completedAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  order       Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  courier     User?        @relation("CourierDeliveries", fields: [courierId], references: [id])

  @@index([courierId, completedAt])
  @@index([completedAt])
}

model OtpCode {
  id        String   @id @default(cuid())
  phone     String
  code      String
  expiresAt DateTime
  used      Boolean  @default(false)
  userId    String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])

  @@index([phone, createdAt])
  @@index([expiresAt])
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Payment {
  id         String          @id @default(cuid())
  orderId    String
  provider   PaymentProvider
  status     PaymentStatus   @default(pending)
  amount     Int
  externalId String?
  metadata   Json?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  order      Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([status, createdAt])
}

model PromoCode {
  id             String        @id @default(cuid())
  /**
   * null bo'lsa — platforma bo'ylab umumiy kod
   */
  organizationId String?
  code           String
  discountType   String        @default("percent")
  discountValue  Int
  maxUses        Int?
  usedCount      Int           @default(0)
  validFrom      DateTime      @default(now())
  validUntil     DateTime?
  isActive       Boolean       @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, code])
  @@index([organizationId])
}

model SmsLog {
  id        String   @id @default(cuid())
  phone     String
  message   String
  status    String   @default("sent")
  provider  String   @default("mock")
  createdAt DateTime @default(now())

  @@index([phone, createdAt])
  @@index([createdAt])
}

/// Telegram bot bilan bog'langan akkaunt (xodim, admin yoki mijoz)
model TelegramAccount {
  id            String   @id @default(cuid())
  /// Telegram foydalanuvchi ID (satr — BigInt serializatsiya muammosisiz)
  telegramId    String   @unique
  /// Shaxsiy chat ID (xabar yuborish uchun)
  chatId        String
  userId        String?  @unique
  username      String?
  firstName     String?
  /// Bot suhbat holati (masalan: buyurtma qidirish kutilmoqda)
  botState      String?
  /// Egalar uchun: tushum bildirishnomalari yoqilganmi
  notifyEnabled Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
}

/// Telegram orqali kirish uchun bir martalik kod
model TelegramLoginCode {
  id        String   @id @default(cuid())
  userId    String
  code      String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([code])
  @@index([userId, createdAt])
}
