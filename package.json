{
  "name": "ximchistka-platform",
  "private": true,
  "packageManager": "npm@11.6.2",
  "scripts": {
    "postinstall": "npm run db:generate",
    "dev": "turbo dev --filter=@ximchistka/api --filter=@ximchistka/crm --filter=@ximchistka/client-web --filter=@ximchistka/merchant",
    "dev:merchant": "npm run dev -w @ximchistka/merchant",
    "dev:mobile": "npm run dev -w @ximchistka/mobile",
    "build": "turbo build",
    "lint": "turbo lint",
    "db:generate": "npm run generate -w @ximchistka/database",
    "db:migrate": "npm run migrate -w @ximchistka/database",
    "db:seed": "npm run seed -w @ximchistka/database",
    "db:push": "npm run push -w @ximchistka/database",
    "dev:api": "npm run dev -w @ximchistka/api",
    "dev:crm": "npm run dev -w @ximchistka/crm",
    "dev:client": "npm run dev -w @ximchistka/client-web",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "overrides": {
    "@nestjs/common": "11.2.1",
    "@nestjs/core": "11.2.1"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "vitest": "^4.1.11"
  },
  "optionalDependencies": {
    "@tailwindcss/oxide-linux-x64-gnu": "4.3.0",
    "@tailwindcss/oxide-win32-x64-msvc": "4.3.0",
    "lightningcss-linux-x64-gnu": "1.32.0",
    "lightningcss-win32-x64-msvc": "1.32.0"
  },
  "engines": {
    "node": ">=20"
  }
}
